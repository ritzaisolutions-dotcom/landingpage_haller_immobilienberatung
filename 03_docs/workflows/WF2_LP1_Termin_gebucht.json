{
  "name": "WF2 – LP1 Termin gebucht (notify-only wenn persistedByLp1)",
  "nodes": [
    {
      "id": "wf2-webhook-termin-gebucht",
      "name": "Termin gebucht Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "termin-gebucht",
        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "wf2-termin-gebucht-lp1"
    },
    {
      "id": "wf2-if-persisted-by-lp1",
      "name": "persistedByLp1?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 300],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-persisted",
              "leftValue": "={{ $json.body.persistedByLp1 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "wf2-lp1-notify-prep",
      "name": "LP1: Daten für Benachrichtigung",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 180],
      "parameters": {
        "jsCode": "const body = $input.first().json.body ?? $input.first().json;\n\nconst datum = body.datum;\nconst uhrzeit = (body.uhrzeit || '').slice(0, 5);\n\nconst dmText = `Guten Tag ${body.name},\\n\\nIhr Besichtigungstermin ist bestätigt!\\n\\n📅 ${datum} um ${uhrzeit} Uhr\\n🏠 Inserat: ${body.inseratId}\\n\\nSie erhalten ggf. eine weitere Nachricht mit Details zur Adresse.\\n\\nMit freundlichen Grüßen\\nHaller Immobilienberatung GmbH`;\n\nconst staffText = `📅 *Neue LP1-Buchung*\\n\\n👤 ${body.name}\\n📧 ${body.email}\\n📱 ${body.telefon}\\n🏠 ${body.inseratId}\\n🕐 ${datum} ${uhrzeit} Uhr\\n\\nLead: \\`${body.leadUuid}\\``;\n\nreturn [{\n  json: {\n    lp1Token: body.lp1Token,\n    leadUuid: body.leadUuid,\n    slotId: body.slotId,\n    name: body.name,\n    email: body.email,\n    telefon: body.telefon,\n    inseratId: body.inseratId,\n    inseratUuid: body.inseratUuid,\n    datum,\n    uhrzeit,\n    dmText,\n    staffText\n  }\n}];"
      }
    },
    {
      "id": "wf2-lp1-calendar-placeholder",
      "name": "Google Calendar Event (TODO)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [920, 80],
      "parameters": {}
    },
    {
      "id": "wf2-lp1-lead-laden",
      "name": "Lead aus Supabase laden",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [920, 200],
      "parameters": {
        "operation": "getAll",
        "tableId": "leads",
        "filterType": "string",
        "matchType": "equals",
        "valueToMatchOn": "={{ $('LP1: Daten für Benachrichtigung').item.json.leadUuid }}",
        "returnAll": false,
        "limit": 1
      },
      "credentials": {
        "supabaseApi": {
          "id": "SUPABASE_CREDENTIAL_ID",
          "name": "Supabase RAIS"
        }
      }
    },
    {
      "id": "wf2-lp1-chatid-merge",
      "name": "Telegram ChatId aufbereiten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1140, 200],
      "parameters": {
        "jsCode": "const prep = $('LP1: Daten für Benachrichtigung').item.json;\nconst lead = $input.first().json;\n\n// Demo: is24_contact_id enthält Telegram chatId (WF1 Demo)\n// Fallback DEINE_CHAT_ID für manuelle Leads / Vorstellung\nconst leadChatId = lead.is24_contact_id || 'DEINE_CHAT_ID';\nconst staffChatId = 'DEINE_CHAT_ID';\n\nreturn [{\n  json: {\n    ...prep,\n    leadChatId,\n    staffChatId,\n    leadName: lead.name || prep.name\n  }\n}];"
      }
    },
    {
      "id": "wf2-lp1-telegram-lead",
      "name": "Bestätigung via Telegram (Demo)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1360, 160],
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{ $json.leadChatId }}",
        "text": "={{ $json.dmText }}",
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": {
          "id": "TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram RAIS Demo Bot"
        }
      }
    },
    {
      "id": "wf2-lp1-telegram-staff",
      "name": "Mitarbeiter-Alert via Telegram (Demo)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1360, 280],
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{ $('Telegram ChatId aufbereiten').item.json.staffChatId }}",
        "text": "={{ $('Telegram ChatId aufbereiten').item.json.staffText }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram RAIS Demo Bot"
        }
      }
    },
    {
      "id": "wf2-legacy-db-updates",
      "name": "Legacy: DB Updates (ohne LP1)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 420],
      "parameters": {
        "jsCode": "// Fallback wenn persistedByLp1 fehlt — alter Integrationspfad\nconst body = $input.first().json.body ?? $input.first().json;\nreturn [{ json: { ...body, legacy: true } }];"
      }
    }
  ],
  "connections": {
    "Termin gebucht Webhook": {
      "main": [[{ "node": "persistedByLp1?", "type": "main", "index": 0 }]]
    },
    "persistedByLp1?": {
      "main": [
        [{ "node": "LP1: Daten für Benachrichtigung", "type": "main", "index": 0 }],
        [{ "node": "Legacy: DB Updates (ohne LP1)", "type": "main", "index": 0 }]
      ]
    },
    "LP1: Daten für Benachrichtigung": {
      "main": [
        [
          { "node": "Google Calendar Event (TODO)", "type": "main", "index": 0 },
          { "node": "Lead aus Supabase laden", "type": "main", "index": 0 }
        ]
      ]
    },
    "Lead aus Supabase laden": {
      "main": [[{ "node": "Telegram ChatId aufbereiten", "type": "main", "index": 0 }]]
    },
    "Telegram ChatId aufbereiten": {
      "main": [
        [
          { "node": "Bestätigung via Telegram (Demo)", "type": "main", "index": 0 },
          { "node": "Mitarbeiter-Alert via Telegram (Demo)", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "meta": {
    "description": "Revidiert V2.1: LP1 persistedByLp1=true → keine DB-Doppelwrites. Telegram-Demo: Bestätigung an Lead (is24_contact_id) + Alert an Mitarbeiter. DEINE_CHAT_ID in n8n ersetzen."
  }
}
