    {
      "id": "7379806b-b528-4b55-bad2-05d1ca26d99e",
      "name": "Batch-Nachricht formatieren",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        200
      ],
      "parameters": {
        "jsCode": "const leads = $input.all().map(i => i.json);\nconst datum = new Date().toLocaleString('de-DE', { timeZone: 'Europe/Berlin' });\n\nconst liste = leads.map((l, i) =>\n  `${i+1}. *${l.name}* | Inserat: ${l.inserat_id} | Score: ${l.mistral_score || '–'}%`\n).join('\\n');\n\nreturn [{\n  json: {\n    anzahl: leads.length,\n    text: `📋 *${leads.length} neue Bewerbung(en) zur Prüfung*\\n_Stand: ${datum}_\\n\\n${liste}\\n\\nBitte im HITL-Interface entscheiden.`\n  }\n}];"
      }
    },
    {
      "id": "2c917ee2-e275-45e2-b29f-b44c2f36375b",
      "name": "Batch via Telegram senden",
