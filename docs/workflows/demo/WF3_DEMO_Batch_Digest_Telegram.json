      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "dcdbb2a2-b97c-4a5d-8bfb-d979eff5d42a",
              "leftValue": "={{ $input.all().length }}",
              "rightValue": 0,
