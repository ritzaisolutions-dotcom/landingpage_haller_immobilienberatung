      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "e0db4421-99bd-4f87-a50f-d934cd7047a7",
              "leftValue": "={{ $input.all().length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "18ae4ca4-7cc6-42cb-a37c-85f800cbbfd6",
      "name": "Batch E-Mail formatieren",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        200
      ],
      "parameters": {
        "jsCode": "const leads = $input.all().map(item => item.json);\nconst anzahl = leads.length;\nconst datum = new Date().toLocaleString('de-DE', { timeZone: 'Europe/Berlin' });\n\n// HTML Tabelle für Email\nlet tabelle = leads.map((l, i) => `\n  <tr style=\"background:${i % 2 === 0 ? '#f8f9fa' : '#ffffff'}\">\n    <td style=\"padding:10px;border:1px solid #dee2e6;\">${i+1}</td>\n    <td style=\"padding:10px;border:1px solid #dee2e6;font-weight:600;\">${l.name}</td>\n    <td style=\"padding:10px;border:1px solid #dee2e6;\">${l.inserat_id}</td>\n    <td style=\"padding:10px;border:1px solid #dee2e6;\">${l.mistral_score || 0}%</td>\n    <td style=\"padding:10px;border:1px solid #dee2e6;\">${l.mindestanforderung_ok ? '✅ Vollständig' : '⚠️ Unvollständig'}</td>\n    <td style=\"padding:10px;border:1px solid #dee2e6;\">\n      <a href=\"${process.env.HITL_UI_URL}/leads/${l.uuid}\" style=\"background:#3B82F6;color:white;padding:6px 14px;border-radius:4px;text-decoration:none;font-size:12px;\">Öffnen →</a>\n    </td>\n  </tr>\n`).join('');\n\nconst htmlBody = `\n<div style=\"font-family:Inter,sans-serif;max-width:700px;margin:0 auto;padding:24px;\">\n  <div style=\"background:#0D1F3C;padding:20px 24px;border-radius:12px 12px 0 0;\">\n    <h1 style=\"color:white;font-size:20px;margin:0;\">📋 ${anzahl} neue Lead${anzahl !== 1 ? 's' : ''} zur Prüfung</h1>\n    <p style=\"color:#6B8AAE;margin:4px 0 0;font-size:13px;\">Batch-Report · ${datum}</p>\n  </div>\n  <div style=\"border:1px solid #1A3A6A;border-top:none;border-radius:0 0 12px 12px;overflow:hidden;\">\n    <table style=\"width:100%;border-collapse:collapse;font-size:13px;\">\n      <thead>\n        <tr style=\"background:#1A3A6A;color:white;\">\n          <th style=\"padding:10px;\">#</th>\n          <th style=\"padding:10px;text-align:left;\">Name</th>\n          <th style=\"padding:10px;text-align:left;\">Inserat</th>\n          <th style=\"padding:10px;\">Score</th>\n          <th style=\"padding:10px;\">Status</th>\n          <th style=\"padding:10px;\">Aktion</th>\n        </tr>\n      </thead>\n      <tbody>${tabelle}</tbody>\n    </table>\n  </div>\n  <p style=\"color:#6B8AAE;font-size:11px;margin-top:16px;text-align:center;\">\n    Automatisch generiert von RAIS · Immobilienverwaltung Haller\n  </p>\n</div>`;\n\nreturn [{ json: { anzahl, datum, htmlBody, leads } }];"
      }
    },
    {
      "id": "aa5c9f8b-c00f-4dea-befb-3874648b58d2",
