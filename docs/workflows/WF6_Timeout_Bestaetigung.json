              "fieldId": "slot_status",
              "fieldValue": "verfuegbar"
            },
            {
              "fieldId": "reserviert_lead_uuid",
              "fieldValue": ""
            },
            {
              "fieldId": "reserviert_bis",
              "fieldValue": ""
            }
          ]
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "SUPABASE_CREDENTIAL_ID",
          "name": "Supabase RAIS"
        }
      }
    },
