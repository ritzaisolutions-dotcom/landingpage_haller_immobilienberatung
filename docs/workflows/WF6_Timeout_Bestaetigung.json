    },
    {
      "id": "d73c334a-140f-4ea8-a8a8-bc6751a8f790",
      "name": "Abgelaufene Reservierungen",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        460,
        180
      ],
      "parameters": {
        "operation": "getAll",
        "tableId": "besichtigungsslots",
        "returnAll": true,
        "filterType": "string",
        "matchType": "equals",
        "valueToMatchOn": "pending"
      },
      "credentials": {
        "supabaseApi": {
          "id": "SUPABASE_CREDENTIAL_ID",
          "name": "Supabase RAIS"
        }
      }
    },
    {
      "id": "6ec67304-34e4-4a29-a1fd-bc120f77258b",
      "name": "Timeout prüfen + freigeben",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        180
      ],
      "parameters": {
        "jsCode": "const slots = $input.all().map(s => s.json);\nconst now = new Date();\nconst abgelaufen = slots.filter(s => new Date(s.reserviert_bis) < now);\nconst nochAktiv = slots.filter(s => new Date(s.reserviert_bis) >= now);\nreturn abgelaufen.map(s => ({ json: { ...s, aktion: 'freigeben' } }));"
      }
    },
    {
      "id": "5c7c6e48-b92e-4132-813b-833939176fab",
      "name": "Slot freigeben in DB",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        900,
        180
      ],
      "parameters": {
        "operation": "update",
        "tableId": "besichtigungsslots",
        "filterType": "string",
        "matchType": "equals",
        "valueToMatchOn": "={{ $json.id }}",
        "fieldsUi": {
          "fieldValues": [
