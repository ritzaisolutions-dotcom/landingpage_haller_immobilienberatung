    {
      "id": "fbacd406-4f79-4bb9-adf2-7643e0ba5f2b",
      "name": "Slot + Lead auf confirmed setzen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        400
      ],
      "parameters": {
        "jsCode": "// Payload von IS24 API (Lead hat mit JA geantwortet)\nconst data = $input.first().json;\nreturn [{\n  json: {\n    leadUuid: data.leadUuid,\n    slotId: data.slotId,\n    bestaetigt: true,\n    bestaetigtAt: new Date().toISOString()\n  }\n}];"
      }
    },
